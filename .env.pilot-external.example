# Intranet pilot profile.
# Copy to .env on the pilot Docker host and fill in intranet Kafka/Langflow values.
# Do not commit real hostnames, passwords, API keys, or service tokens.

DEPLOY_PROFILE=pilot-external
KAFKA_MODE=external
LANGFLOW_MODE=external

BOI_API_PORT=28000
ACTION_GATEWAY_PORT=8100
BOI_WIKI_MCP_PORT=8200

BOI_EXTERNAL_URL=https://wiki.example.internal
BOI_DATALAKE_MODE=bundled
BOI_KNOWLEDGE_HEALTH_ENABLED=true
BOI_KNOWLEDGE_HEALTH_HOUR=2
BOI_DATALAKE_ENABLED=true
BOI_DATALAKE_PROFILE=bundled
BOI_DATALAKE_REQUIRED=true
BOI_DATALAKE_MINIO_ENDPOINT=http://data-lake-minio:9000
BOI_DATALAKE_MINIO_ROOT_USER=boi_datalake
BOI_DATALAKE_MINIO_ROOT_PASSWORD=replace-me
BOI_DATALAKE_BUCKET=boi-datalake
LANGFLOW_EXTERNAL_URL=https://langflow.example.internal
KAFKA_UI_EXTERNAL_URL=
BOI_WIKI_MCP_EXTERNAL_URL=https://wiki-mcp.example.internal
ACTION_GATEWAY_EXTERNAL_URL=

BOI_AUTH_MODE=trusted_header
SERVICE_TOKEN=replace-with-random-service-token
BOI_SESSION_SECRET=replace-with-random-session-secret
BOI_COOKIE_SECURE=true
DEFAULT_TEAM_ID=aix-tf
DEMO_EMPLOYEE_ID=100001

BOI_CONTENT_ROOT=/content/data/boi
BOI_CONTENT_SAFE_DIRECTORY=/content
BOI_RUNTIME_ROOT=/runtime
BOI_INBOX_REPORT_AUTO_GENERATE=true
BOI_INBOX_REPORT_BACKFILL_SCOPE=all
BOI_INBOX_REPORT_SCAN_INTERVAL_SECONDS=30
BOI_INBOX_REPORT_BATCH_SIZE=8
BOI_SEARCH_AUTO_SYNC=true
BOI_SEARCH_SYNC_DEBOUNCE_SECONDS=2
BOI_SEARCH_SYNC_RECONCILE_SECONDS=300
BOI_SEARCH_SYNC_BATCH_SIZE=16
BOI_RUNTIME_HISTORY_SEED_ROOT=/content/data
BOI_RUNTIME_HISTORY_SEED_ACTION_FULL_SCAN_MAX_BYTES=67108864
BOI_RUNTIME_HISTORY_SEED_ACTION_RAW_READ_MAX_BYTES=16777216
BOI_EXPECT_MIN_MARKDOWN_DOCUMENTS=1
BOI_CONTENT_HOST_PATH=/srv/boi-wiki/content
BOI_CONTENT_MOUNT_PATH=/content
# Set this to the numeric UID:GID that owns /srv/boi-wiki/content.
BOI_API_RUN_AS=1000:1000
EVENTS_HOST_PATH=/srv/boi-wiki/runtime/events
ACTIONS_HOST_PATH=/srv/boi-wiki/runtime/actions
EVENTS_ROOT=/runtime/events
ACTION_LOG_ROOT=/runtime/actions
WORKFLOW_CATALOG_ROOT=/data/workflow_catalog
EVENT_SKILL_CATALOG_ROOT=/data/event_skill_catalog
ACTION_SKILL_CATALOG_ROOT=/data/action_skill_catalog
AGENT_CATALOG_ROOT=/data/agent_catalog
BOI_AUTO_COMMIT=true
BOI_AUTO_PUSH=true
BOI_CONTENT_GIT_REMOTE=origin
BOI_CONTENT_GIT_BRANCH=main

KAFKA_BOOTSTRAP=kafka-bootstrap.example.internal:9093
KAFKA_SMOKE_BOOTSTRAP=kafka-bootstrap.example.internal:9093
BOI_EVENTS_TOPIC=boi.events
BOI_RAW_SIGNALS_TOPIC=boi.raw-signals
BOI_AUDIT_TOPIC=boi.audit
BOI_DLQ_TOPIC=boi.dead-letter
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=replace-with-service-account
KAFKA_SASL_PASSWORD=replace-with-service-password
KAFKA_SSL_CAFILE=/run/secrets/kafka-ca.pem
EVENT_ROUTER_GROUP_ID=boi-event-router-pilot
EVENT_ROUTER_AUTO_OFFSET_RESET=latest
AUTO_ROUTE_EVENTS=true

LANGFLOW_URL=https://langflow-api.example.internal
LANGFLOW_SMOKE_URL=https://langflow-api.example.internal
LANGFLOW_API_KEY=replace-with-langflow-api-key
LANGFLOW_AUTH_MODE=api-key
LANGFLOW_BOI_AGENT_ENDPOINT=boi-agent
LANGFLOW_AGENT_TIMEOUT_SECONDS=180

BOI_LLM_BASE_URL=https://llm-gateway.example.internal/v1
BOI_LLM_MODEL=google/gemma-4-26b-a4b-qat
BOI_LLM_API_KEY=replace-with-llm-api-key
BOI_AGENT_BACKEND=native
BOI_AGENT_ROUTER_MODE=llm_first
BOI_AGENT_ROUTER_REQUIRED=1
BOI_AGENT_STATUS_REQUIRED=1
BOI_AGENT_SUGGESTIONS_REQUIRED=1
BOI_AGENT_COMPOSER_REQUIRED=1
BOI_AGENT_SUGGESTIONS_MAX_ATTEMPTS=3
BOI_AGENT_LLM_MAX_CONCURRENCY=1
BOI_AGENT_LLM_QUEUE_TIMEOUT_SECONDS=120
BOI_DEEPAGENTS_ENABLED=auto
BOI_DEEPAGENTS_MODEL=
BOI_DEEPAGENTS_TIMEOUT_SECONDS=45
BOI_PGVECTOR_DSN=
BOI_PET_AGENT_ENABLED=true
BOI_AGENT_LANGGRAPH_REQUIRED=1
BOI_AGENT_CACHE_WARMUP_ON_STARTUP=1
BOI_AGENT_V2_ENABLED=true
BOI_AGENT_V2_DEFAULT=true
BOI_AGENT_V2_REQUIRE_POSTGRES=true
BOI_AGENT_POSTGRES_USER=boi_agent
BOI_AGENT_POSTGRES_PASSWORD=replace-with-random-agent-db-password
BOI_AGENT_POSTGRES_DB=boi_agent
BOI_PAT_HASH_SECRET=replace-with-random-pat-hash-secret
BOI_AGENT_USE_OPENAI_RUNTIME=false
BOI_GPT55_TEST_MODE=false
BOI_GPT55_TEST_BASE_URL=https://api.openai.com/v1
BOI_GPT55_TEST_MODEL=gpt-5.5
BOI_GPT55_TEST_API_KEY=
BOI_V2_MODEL_PROVIDER=openai_compatible
BOI_V2_MODEL_BASE_URL=https://llm-gateway.example.internal/v1
BOI_V2_MODEL_API_KEY=replace-with-llm-api-key
BOI_V2_MODEL=replace-with-approved-model
BOI_V2_REASONING_EFFORT=
BOI_V2_MAX_OUTPUT_TOKENS=4096
BOI_DEEPAGENTS_MAX_INPUT_TOKENS=40000
BOI_EMBEDDING_PROVIDER=openai_compatible
BOI_EMBEDDING_BASE_URL=https://embedding-gateway.example.internal/v1
BOI_EMBEDDING_API_KEY=replace-with-embedding-api-key
BOI_EMBEDDING_MODEL=replace-with-approved-embedding-model
BOI_EMBEDDING_DIMENSIONS=1536
# Keep disabled for a generic OpenAI-compatible gateway. Enable only when both
# models are served by one LM Studio instance and its native API is reachable.
BOI_LMSTUDIO_REQUIRE_PRELOADED_MODELS=false
BOI_LMSTUDIO_NATIVE_BASE_URL=
BOI_LMSTUDIO_STARTUP_TIMEOUT_SECONDS=120
BOI_AGENT_V2_RUN_TOKEN_BUDGET=32000
BOI_AGENT_V2_DEEP_TOKEN_BUDGET=160000
BOI_AGENT_V2_INDEPENDENT_REVIEW=true
MCP_V2_REQUIRE_PAT=true
BOI_API_PAT=
