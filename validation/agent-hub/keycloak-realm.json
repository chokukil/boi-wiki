        "http://localhost:28002/auth/callback",
        "http://localhost:28005/auth/callback",
        "http://localhost:17867/oauth2/callback",
        "http://wiki.skhynix.com/auth/callback",
        "http://wiki.skhynix.com/builder/oauth2/callback"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:28002/*##http://localhost:28005/*##http://localhost:17867/*##http://wiki.skhynix.com/*",
        "pkce.code.challenge.method": "S256"
      },
      "webOrigins": [
        "http://localhost:28002",
        "http://localhost:28005",
        "http://localhost:17867",
        "http://wiki.skhynix.com"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "employee number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "empno",
            "claim.name": "empno",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
