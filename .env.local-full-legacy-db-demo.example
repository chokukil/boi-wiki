# Optional Legacy DB Demo overlay for local-full.
# Use with:
#   BOI_COMPOSE_PROFILE=local-full-legacy-db-demo \
#   BOI_ENV_FILE=.env.local-full.example \
#   BOI_ENV_OVERLAY_FILE=.env:.env.local-full-datalake.example:.env.local-full-legacy-db-demo.example \
#   ./scripts/start_local_full.sh
#
# This profile adds a PostgreSQL demo adapter that mimics legacy structured
# query systems. It is not the OKF store and is not required for the Data Lake
# artifact flow.

DEPLOY_PROFILE=local-full-legacy-db-demo
BOI_DATALAKE_ENABLED=true
BOI_DATALAKE_PROFILE=local-full-legacy-db-demo

BOI_LEGACY_DB_DEMO_ENABLED=true
BOI_LEGACY_DB_DEMO_POSTGRES_PORT=15432
BOI_LEGACY_DB_DEMO_POSTGRES_USER=boi_legacy_demo
BOI_LEGACY_DB_DEMO_POSTGRES_PASSWORD=boi_legacy_demo
BOI_LEGACY_DB_DEMO_POSTGRES_DB=boi_legacy_demo
BOI_LEGACY_DB_DEMO_POSTGRES_DSN=postgresql://boi_legacy_demo:boi_legacy_demo@legacy-db-demo-postgres:5432/boi_legacy_demo
