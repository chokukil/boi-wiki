# Optional Data Lake overlay for local-full.
# Use with:
#   BOI_COMPOSE_PROFILE=local-full-datalake \
#   BOI_ENV_FILE=.env.local-full.example \
#   BOI_ENV_OVERLAY_FILE=.env:.env.local-full-datalake.example \
#   ./scripts/start_local_full.sh
#
# This profile enables the user-facing Data Lake artifact store.
# Data Lake means MinIO-backed object storage for original files and generated
# artifacts. OKF content remains Markdown/JSONL; BoI documents only reference
# stable artifact URLs and bounded metadata.

DEPLOY_PROFILE=local-full-datalake
BOI_DATALAKE_ENABLED=true
BOI_DATALAKE_PROFILE=local-full-datalake

# MinIO artifact endpoint. User-facing name is Data Lake.
BOI_DATALAKE_MINIO_PORT=19000
BOI_DATALAKE_MINIO_CONSOLE_PORT=19001
BOI_DATALAKE_MINIO_ROOT_USER=boi_datalake
BOI_DATALAKE_MINIO_ROOT_PASSWORD=boi_datalake_password
BOI_DATALAKE_MINIO_ENDPOINT=http://data-lake-minio:9000
BOI_DATALAKE_BUCKET=boi-datalake

# Optional ontology fixture import source. This is mounted read-only into boi-api.
# Leave as-is when ~/ontology is present; override for another local fixture copy.
BOI_DATALAKE_FIXTURE_HOST_PATH=/home/chokukil/ontology
BOI_DATALAKE_FIXTURE_ROOT=/fixtures/ontology
