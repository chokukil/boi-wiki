# Local full-stack verification profile.
# Copy to .env.local-full or .env when validating without intranet Kafka/Langflow.

DEPLOY_PROFILE=local-full
KAFKA_MODE=local
LANGFLOW_MODE=local

BOI_API_PORT=28000
ACTION_GATEWAY_PORT=8100
BOI_WIKI_MCP_PORT=8200
LANGFLOW_PORT=7860
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8081
BOI_DATALAKE_MODE=bundled
BOI_KNOWLEDGE_HEALTH_ENABLED=true
BOI_KNOWLEDGE_HEALTH_HOUR=2
BOI_DATALAKE_ENABLED=true
BOI_DATALAKE_PROFILE=bundled
BOI_DATALAKE_REQUIRED=true
BOI_DATALAKE_MINIO_PORT=19000
BOI_DATALAKE_MINIO_CONSOLE_PORT=19001
BOI_DATALAKE_MINIO_ENDPOINT=http://data-lake-minio:9000
BOI_DATALAKE_MINIO_ROOT_USER=boi_datalake
BOI_DATALAKE_MINIO_ROOT_PASSWORD=boi_datalake_password
BOI_DATALAKE_BUCKET=boi-datalake

BOI_EXTERNAL_URL=http://localhost:28000
LANGFLOW_EXTERNAL_URL=http://localhost:7860
KAFKA_UI_EXTERNAL_URL=http://localhost:8081
BOI_WIKI_MCP_EXTERNAL_URL=http://localhost:8200
ACTION_GATEWAY_EXTERNAL_URL=http://localhost:8100

BOI_AUTH_MODE=dev
SERVICE_TOKEN=dev-service-token-change-me
DEFAULT_TEAM_ID=aix-tf
DEMO_EMPLOYEE_ID=100001

BOI_CONTENT_ROOT=/workspace/data/boi
BOI_CONTENT_SAFE_DIRECTORY=/workspace
BOI_RUNTIME_ROOT=/data
BOI_INBOX_REPORT_AUTO_GENERATE=true
BOI_INBOX_REPORT_BACKFILL_SCOPE=all
BOI_INBOX_REPORT_SCAN_INTERVAL_SECONDS=30
BOI_INBOX_REPORT_BATCH_SIZE=8
BOI_SEARCH_AUTO_SYNC=true
BOI_SEARCH_SYNC_DEBOUNCE_SECONDS=2
BOI_SEARCH_SYNC_RECONCILE_SECONDS=300
BOI_SEARCH_SYNC_BATCH_SIZE=16
BOI_RUNTIME_HISTORY_SEED_ROOT=/workspace/data
BOI_EXPECT_MIN_MARKDOWN_DOCUMENTS=1
BOI_CONTENT_HOST_PATH=.
BOI_CONTENT_MOUNT_PATH=/workspace
# start_local_full.sh overrides this with the current host UID:GID.
BOI_API_RUN_AS=1000:1000
EVENTS_HOST_PATH=./data/events
ACTIONS_HOST_PATH=./data/actions
BOI_RUNTIME_LOG_MAX_BYTES=10485760
BOI_RUNTIME_LOG_RETENTION_DAYS=30
BOI_RUNTIME_LOG_ARCHIVE_ENABLED=false
BOI_RUNTIME_INDEX_ENABLED=true
BOI_RUNTIME_HISTORY_SEED_ACTION_FULL_SCAN_MAX_BYTES=67108864
BOI_RUNTIME_HISTORY_SEED_ACTION_RAW_READ_MAX_BYTES=16777216
WORKFLOW_CATALOG_ROOT=/data/workflow_catalog
EVENT_SKILL_CATALOG_ROOT=/data/event_skill_catalog
ACTION_SKILL_CATALOG_ROOT=/data/action_skill_catalog
AGENT_CATALOG_ROOT=/data/agent_catalog
BOI_AUTO_COMMIT=true
BOI_AUTO_PUSH=false
BOI_CONTENT_GIT_REMOTE=origin
BOI_CONTENT_GIT_BRANCH=

KAFKA_BOOTSTRAP=kafka:9092
KAFKA_SMOKE_BOOTSTRAP=localhost:9094
BOI_EVENTS_TOPIC=boi.events
BOI_RAW_SIGNALS_TOPIC=boi.raw-signals
BOI_AUDIT_TOPIC=boi.audit
BOI_DLQ_TOPIC=boi.dead-letter
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
EVENT_ROUTER_AIOKAFKA_LOG_LEVEL=CRITICAL
EVENT_ROUTER_GROUP_ID=boi-event-router-local
EVENT_ROUTER_AUTO_OFFSET_RESET=earliest
EVENT_ROUTER_STARTUP_DELAY_SECONDS=5
EVENT_ROUTER_TOPIC_READY_TIMEOUT_SECONDS=60
EVENT_ROUTER_TOPIC_READY_INTERVAL_SECONDS=2
EVENT_ROUTER_POST_TOPIC_READY_DELAY_SECONDS=5
AUTO_ROUTE_EVENTS=true

LANGFLOW_URL=http://langflow:7860
LANGFLOW_SMOKE_URL=http://localhost:7860
LANGFLOW_API_KEY=dev-langflow-key-change-me
LANGFLOW_AUTH_MODE=api-key
LANGFLOW_BOI_AGENT_ENDPOINT=boi-agent
LANGFLOW_AGENT_TIMEOUT_SECONDS=180
LANGFLOW_AUTO_LOGIN=True
LANGFLOW_SKIP_AUTH_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin

BOI_LLM_BASE_URL=http://llm-gateway.example:1236/v1
BOI_LLM_MODEL=google/gemma-4-26b-a4b-qat
BOI_LLM_API_KEY=not-needed
BOI_AGENT_BACKEND=native
BOI_AGENT_ROUTER_MODE=llm_first
BOI_AGENT_ROUTER_REQUIRED=1
BOI_AGENT_STATUS_REQUIRED=1
BOI_AGENT_SUGGESTIONS_REQUIRED=1
BOI_AGENT_COMPOSER_REQUIRED=1
BOI_AGENT_SUGGESTIONS_MAX_ATTEMPTS=3
BOI_AGENT_LLM_MAX_CONCURRENCY=1
BOI_AGENT_LLM_QUEUE_TIMEOUT_SECONDS=120
BOI_DEEPAGENTS_ENABLED=auto
BOI_DEEPAGENTS_MODEL=
BOI_DEEPAGENTS_TIMEOUT_SECONDS=45
BOI_PGVECTOR_DSN=
BOI_PET_AGENT_ENABLED=true
BOI_AGENT_LANGGRAPH_REQUIRED=1
BOI_AGENT_CACHE_WARMUP_ON_STARTUP=1
BOI_AGENT_V2_ENABLED=true
BOI_AGENT_V2_DEFAULT=true
BOI_AGENT_V2_REQUIRE_POSTGRES=true
BOI_AGENT_POSTGRES_PORT=15433
BOI_AGENT_POSTGRES_USER=boi_agent
BOI_AGENT_POSTGRES_PASSWORD=boi_agent_dev_change_me
BOI_AGENT_POSTGRES_DB=boi_agent
BOI_PAT_HASH_SECRET=dev-pat-hash-secret-change-me
BOI_AGENT_USE_OPENAI_RUNTIME=false
BOI_GPT55_TEST_MODE=false
BOI_GPT55_TEST_BASE_URL=https://api.openai.com/v1
BOI_GPT55_TEST_MODEL=gpt-5.5
BOI_GPT55_TEST_API_KEY=
BOI_V2_MODEL_PROVIDER=openai_compatible
BOI_V2_MODEL_BASE_URL=http://llm-gateway.example:1236/v1
BOI_V2_MODEL_API_KEY=not-needed
BOI_V2_MODEL=google/gemma-4-26b-a4b-qat
BOI_DEEPAGENTS_MODEL=google/gemma-4-26b-a4b-qat
BOI_V2_REASONING_EFFORT=none
BOI_V2_MAX_OUTPUT_TOKENS=8192
BOI_V2_MODEL_CONTEXT_WINDOW=0
BOI_AGENT_LLM_MAX_CONCURRENCY=1
BOI_AGENT_LLM_QUEUE_TIMEOUT_SECONDS=120
BOI_V2_MODEL_CONTEXT_FALLBACK=131072
BOI_V2_MODEL_CONTEXT_RESERVE=8192
BOI_DEEPAGENTS_MAX_INPUT_TOKENS=0
BOI_DEEPAGENTS_MIN_WINDOW_TOKENS=16000
BOI_AGENT_V2_RETRIEVAL_CANDIDATE_LIMIT=48
BOI_EMBEDDING_PROVIDER=openai_compatible
BOI_EMBEDDING_BASE_URL=http://llm-gateway.example:1236/v1
BOI_EMBEDDING_API_KEY=not-needed
BOI_EMBEDDING_MODEL=text-embedding-bge-m3
BOI_EMBEDDING_DIMENSIONS=1024
# Optional developer-PC guard. Keep false for a managed internal model server.
BOI_LMSTUDIO_REQUIRE_PRELOADED_MODELS=false
BOI_LMSTUDIO_NATIVE_BASE_URL=http://llm-gateway.example:1236
BOI_LMSTUDIO_STARTUP_TIMEOUT_SECONDS=120
BOI_AGENT_V2_RUN_TOKEN_BUDGET=4000000
BOI_AGENT_V2_RESPONSE_BUDGET_BYTES=262144
BOI_AGENT_V2_DEEP_TOKEN_BUDGET=1000000
BOI_AGENT_V2_INDEPENDENT_REVIEW=true
MCP_V2_REQUIRE_PAT=true
BOI_API_PAT=
