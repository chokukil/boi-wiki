    "EvidenceUse": {
      "additionalProperties": false,
      "properties": {
        "span_ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Span Ref",
          "type": "string"
        },
        "span_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Span Digest",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_identity_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Record Identity Digest",
          "type": "string"
        },
        "source_revision_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Revision Digest",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "field_pointer": {
          "pattern": "^/",
          "title": "Field Pointer",
          "type": "string"
        },
        "representation": {
          "enum": [
            "raw",
            "normalized",
            "translated",
            "extracted"
          ],
          "title": "Representation",
          "type": "string"
        },
        "transformation_refs": {
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "title": "Transformation Refs",
          "type": "array"
        },
        "supports_contract_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Supports Contract Digest",
          "type": "string"
        },
        "supports_fields": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supports Fields",
          "type": "array"
        },
        "use_kind": {
          "enum": [
            "source_presence",
            "reported_description",
            "declared_definition",
            "policy",
            "physical_observation",
            "review"
          ],
          "title": "Use Kind",
          "type": "string"
        },
        "support_basis": {
          "enum": [
            "presence_only",
            "model_proposed",
            "approved_structured_contract",
            "human_reviewed_interpretation"
          ],
          "title": "Support Basis",
          "type": "string"
        },
        "review_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "span_ref",
        "span_digest",
        "content_digest",
        "record_identity_digest",
        "source_revision_digest",
        "snapshot_digest",
        "field_pointer",
        "representation",
        "transformation_refs",
        "supports_contract_digest",
        "supports_fields",
        "use_kind",
        "support_basis",
        "review_receipt_ref"
