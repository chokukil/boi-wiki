    "SemanticDescriptor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Term",
            "ObjectType",
            "PropertyDefinition",
            "RelationType",
            "ValueType",
            "Metric",
            "Rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Definition",
          "type": "string"
        },
        "aliases": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "target_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "concept",
            "entity",
            "event",
            "observation",
            "measurement",
            "setpoint",
            "upper_limit",
            "lower_limit",
            "computed",
            "rule",
            "relationship"
          ],
          "title": "Role",
          "type": "string"
        },
        "quantity_kind_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity Kind Ref"
        },
        "unit_semantics": {
          "enum": [
            "declared",
            "dimensionless",
            "not_applicable",
            "unknown"
          ],
          "title": "Unit Semantics",
          "type": "string",
          "description": "declared requires a quantity reference and a version-pinned unit definition; a source unit label alone is not this binding."
        },
        "unit_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Ref"
        },
        "unit_revision_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Revision Digest"
        },
        "value_semantics": {
          "enum": [
            "absolute",
            "interval",
            "categorical",
            "not_applicable",
            "unknown"
          ],
          "title": "Value Semantics",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SemanticScope"
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
