    "ApplicabilityContract": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "conditions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "conditions"
      ],
      "title": "ApplicabilityContract",
      "type": "object"
    },
    "BusinessVersionIdentity": {
