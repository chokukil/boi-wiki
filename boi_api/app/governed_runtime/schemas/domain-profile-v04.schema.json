              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Ref"
        },
        "unit_revision_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Revision Digest"
        },
        "unit_semantics": {
          "enum": [
            "declared",
            "dimensionless",
            "not_applicable",
            "unknown"
          ],
          "title": "Unit Semantics",
          "type": "string",
          "description": "declared requires a quantity reference and a version-pinned unit definition; a source unit label alone is not this binding."
        },
        "value_semantics": {
          "enum": [
            "absolute",
            "interval",
            "categorical",
            "not_applicable",
            "unknown"
          ],
          "title": "Value Semantics",
          "type": "string"
        }
