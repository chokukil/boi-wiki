    "SemanticDescriptor": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "authority_basis": {
          "enum": [
            "policy",
            "master_data",
            "system_of_record",
            "steward_review",
            "observed",
            "source_reported"
          ],
          "title": "Authority Basis",
          "type": "string",
          "description": "Declared provenance of the definition, not an authority grant. source_reported means the source describes this definition; it does not establish a physical observation, verified equipment identity, live binding, release qualification or execution permission. Reading source text does not change source_reported into observed."
        },
        "conditions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
