              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity Kind Ref"
        },
        "role": {
          "enum": [
            "concept",
            "entity",
            "event",
            "observation",
            "measurement",
            "setpoint",
            "upper_limit",
            "lower_limit",
            "computed",
            "rule",
            "relationship"
          ],
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SemanticScope"
        },
        "target_kind": {
